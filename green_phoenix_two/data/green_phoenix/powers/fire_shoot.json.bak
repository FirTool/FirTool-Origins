{
    "type": "origins:multiple",
    "projectile": {
        "type": "origins:fire_projectile",
        "entity_type": "minecraft:fireball",
        "cooldown": 200,
		
		
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_01.png",
            "bar_index": 1
        },
        "count": 1,
        "speed": 2,
		"sound": "minecraft:entity.blaze.shoot",
        "divergence": 1,
		"tag": "{ Item: {id:'minecraft:magma_block', Count: 4b}, ExplosionPower:1}",
		"key": {
            "key": "key.origins.primary_active",
			"continuous": false
        }
    },
	"particles": {
		"type": "origins:action_over_time",
		"interval": 1,
		"entity_action": {
			"type": "origins:execute_command",
			"command": "execute at @e[type=fireball] if block ~ ~-1 ~ air run particle glow ~ ~ ~"
		}
	},
	
"name": "Fire Breath",
"description": "Can shoot a fireball towards the enemy."
}
	