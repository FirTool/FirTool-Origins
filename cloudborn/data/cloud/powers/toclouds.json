{    
    "name": "§eTo The Clouds!",
	"description": "Gather the wind and air around you to send nearby foes (and yourself) in the air! §c(do not do near pets or farm, trust)",
	   "type": "origins:active_self",
    "entity_action": {
        "type": "origins:and",
        "actions": [
            {
                "type": "origins:execute_command",
                "command": "effect give @e[distance=..9] minecraft:levitation 2 25 true",
                "permission_level": 4
            },
			{
				"type": "origins:execute_command",
                "command": "effect give @e[distance=..9] minecraft:instant_damage 1 0 true",
                "permission_level": 4
			},
			{ 
			    "type": "origins:execute_command",
                "command": "playsound minecraft:entity.shulker.shoot player @s ~ ~ ~ 1 1",
				"permission_level": 4
			},
			{ 
			    "type": "origins:execute_command",
                "command":"execute as @p at @p run particle particle minecraft:flash ~ ~ ~ normal",
				"permission_level": 4
			},
			{
                "type": "origins:execute_command",
                "command": "effect give @e[distance=..9] minecraft:slow_falling 10 1 true",
                "permission_level": 4
            }
			]
	},
	"cooldown": 1800,
	"key": {
		"key": "key.origins.primary_active",
		"continuous": false
	},
	"hud_render": {
		"should_render": true,
		"sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_03.png:",
		"bar_index": 16
	}
}